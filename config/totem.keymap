#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SYM  3
#define F    4

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <255>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
    };

    macros {
        copy: copy {
            label = "COPY";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&kp C>,
                <&macro_release>,
                <&kp LEFT_GUI>;
        };

        paste: paste {
            label = "PASTE";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&kp V>,
                <&macro_release>,
                <&kp LEFT_GUI>;
        };

        cut: cut {
            label = "CUT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&kp X>,
                <&macro_release>,
                <&kp LEFT_GUI>;
        };

        undo: undo {
            label = "UNDO";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&kp Z>,
                <&macro_release>,
                <&kp LEFT_GUI>;
        };

        redo: redo {
            label = "REDO";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp Z>,
                <&macro_release>,
                <&kp LSHFT>,
                <&kp LEFT_GUI>;
        };

        screenshot: screenshot {
            label = "SCREENSHOT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N4>,
                <&macro_release>,
                <&kp LSHFT>,
                <&kp LEFT_GUI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";

            bindings = <
                &kp Q        &kp W       &kp E             &kp R           &kp T        &kp Y        &kp U             &kp I             &kp O       &kp P
                &mt LCTRL A  &mt LALT S  &mt LEFT_SHIFT D  &mt LEFT_GUI F  &kp G        &kp H        &mt RIGHT_META J  &mt LEFT_SHIFT K  &mt RALT L  &mt LCTRL SEMICOLON
                &mt F24 CAPS  &kp Z       &kp X             &kp C           &kp V        &kp B        &kp N             &kp M             &kp COMMA   &kp DOT     &kp FSLH   &kp SQT
                                                     &kp ESCAPE   &lt 1 SPACE    &kp TAB    &lt 3 ENTER   &lt 2 BACKSPACE   &lt 4 DELETE
            >;
        };

        nav_layer {
            label = "NAV";

            bindings = <
                &kp ESC      &bt BT_CLR  &kp UP    &kp EQUAL  &kp LBRC    &copy         &kp PG_UP       &kp UP_ARROW    &kp PAGE_DOWN  &kp KP_PLUS
                &kp LSHFT    &kp LEFT    &kp DOWN  &kp RIGHT  &kp LBKT    &paste        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT      &kp KP_MINUS
                &screenshot  &kp DEL     &kp PG_UP &kp CAPS   &kp PG_DN   &kp LPAR      &undo          &kp HOME        &kp CAPS       &kp END       &redo    &cut
                                                     &trans      &trans      &trans     &kp ENTER     &kp BACKSPACE    &kp DEL
            >;
        };

        num_layer {
            label = "NUM";

            bindings = <
                &kp LEFT_BRACKET  &kp N7        &kp N8        &kp N9        &kp RIGHT_BRACKET   &kp CARET     &kp AMPS        &kp RA(U)   &kp SQT     &kp DQT
                &kp SEMICOLON     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL           &kp C_MUTE    &kp LS(RA(N4))  &kp RA(N5)  &kp RA(N4)  &kp RA(O)
                &trans            &kp GRAVE     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3        &kp NON_US_BACKSLASH  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV  &kp C_NEXT  &kp BSLH   &trans
                                                              &kp PERIOD    &kp N0        &kp MINUS           &trans        &kp C_PP        &trans
            >;
        };

        sym_layer {
            label = "SYM";

            bindings = <
                &kp LEFT_BRACE  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_BRACE  &trans  &trans  &trans  &trans  &trans
                &kp COLON       &kp DOLLAR     &kp PERCENT   &kp CARET            &kp PLUS         &trans  &trans  &trans  &trans  &trans
                &trans          &kp TILDE      &kp EXCLAMATION  &kp AT_SIGN        &kp HASH         &kp PIPE  &trans  &trans  &trans  &trans  &trans  &trans
                                                              &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE  &trans  &trans  &trans
            >;
        };

        func_layer {
            label = "F";

            bindings = <
                &kp F1   &kp F2   &kp F3   &kp F4   &kp F5    &kp F6   &kp F7   &kp F8   &kp F9   &kp F10
                &kp F11  &kp F12  &kp F13  &kp F14  &kp F15   &kp F16  &kp F17  &kp F18  &kp F19  &kp F20
                &trans   &kp F21  &kp F22  &kp F23  &kp F24   &trans   &trans   &trans   &trans   &trans   &trans  &trans
                                                     &trans    &trans   &trans    &trans   &trans    &trans
            >;
        };
    };
};
