            #binding-cells = <0>;
            bindings = <&kp N3 &kp N9>;
        };
        rc_32: rc_32 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N3 &kp N2>;
        };
        rc_33: rc_33 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N3 &kp N3>;
        };
        rc_34: rc_34 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
