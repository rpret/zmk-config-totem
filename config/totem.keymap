#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// DIAGNOSTIC PIN MAPPER - each key types its raw matrix (row,col) as two digits.
// Home-row F should type 13 (row 1, col 3 = D9). A types 10 (row 1, col 0 = D4).
/ {
    keymap {
        compatible = "zmk,keymap";
        base_layer {
            bindings = <
                &rc_00 &rc_01 &rc_02 &rc_03 &rc_04 &rc_05 &rc_06 &rc_07 &rc_08 &rc_09
                &rc_10 &rc_11 &rc_12 &rc_13 &rc_14 &rc_15 &rc_16 &rc_17 &rc_18 &rc_19
                &rc_30 &rc_20 &rc_21 &rc_22 &rc_23 &rc_24 &rc_25 &rc_26 &rc_27 &rc_28 &rc_29 &rc_39
                &rc_32 &rc_33 &rc_34 &rc_35 &rc_36 &rc_37
                >;
        };
    };

    macros {
        rc_00: rc_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
        };
        rc_01: rc_01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N1>;
        };
        rc_02: rc_02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N2>;
        };
        rc_03: rc_03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N3>;
        };
        rc_04: rc_04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N4>;
        };
        rc_05: rc_05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N5>;
        };
        rc_06: rc_06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N6>;
        };
        rc_07: rc_07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N7>;
        };
        rc_08: rc_08 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N8>;
        };
        rc_09: rc_09 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N9>;
        };
        rc_10: rc_10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N0>;
        };
        rc_11: rc_11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N1>;
        };
        rc_12: rc_12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N2>;
        };
        rc_13: rc_13 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N3>;
        };
        rc_14: rc_14 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N4>;
        };
        rc_15: rc_15 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
